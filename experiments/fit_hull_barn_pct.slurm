#!/bin/bash
#SBATCH --job-name=hull-pct
#SBATCH --output=/home/glenain/Sphere-traced-1-Lipschitz-MLPs-/outputs/hull-pct_%j.slurm.log
#SBATCH --error=/home/glenain/Sphere-traced-1-Lipschitz-MLPs-/outputs/hull-pct_%j.slurm.log
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=64G
#SBATCH --partition=gpu
#SBATCH --time=02:00:00
#SBATCH --exclude=gpu001,gpu002,gpu003,gpu004,gpu006,gpu007,gpu008,gpu009,gpu011,gpu014

SCENE=/home/glenain/Sphere-traced-1-Lipschitz-MLPs-/data/tnt/Barn
source /scratch/_projets_/willow/1-lip-tracer-new/.venv/bin/activate
cd /home/glenain/Sphere-traced-1-Lipschitz-MLPs-

OUT=/home/glenain/Sphere-traced-1-Lipschitz-MLPs-/outputs/hull_pct_Barn_${SLURM_JOB_ID}
mkdir -p "$OUT"

# Sky masks should already be present (regenerated by the diag job). If not, generate.
if [[ ! -f "$SCENE/mask/_overview.png" ]]; then
    python -u tools/sky_segment.py --scene "$SCENE" 2>&1 | tee "$OUT/log.txt"
else
    echo "[seg] reusing existing masks in $SCENE/mask" | tee "$OUT/log.txt"
fi

python -u tools/fit_hull_barn_pct.py \
    --scene "$SCENE" \
    --out-dir "$OUT" \
    --res 192 --bound 1.5 --down 2 --fit-steps 2000 \
    --thresholds 1.00 0.99 0.95 0.90 \
    --best-thresh 0.95 \
    --min-views 8 2>&1 | tee -a "$OUT/log.txt"
